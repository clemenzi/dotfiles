{
  "name": "dotfiles",
  "scripts": {
    "fmt": "stylua --config-path stylua.toml --glob '**/*.lua' .",
    "prepare": "lefthook install"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@johnnymorganz/stylua-bin": "^2.5.2",
    "lefthook": "^2.1.12"
  }
}
